#!/usr/bin/env bash
#
# openclaw-watchdog — OpenClaw Gateway 健康监控 CLI
#
# 每 5 分钟检查 gateway 健康状态，异常时自动重启。
# 使用 macOS launchd 调度，零额外依赖。
#
# 用法:
#   openclaw-watchdog start    安装并启动定时监控
#   openclaw-watchdog stop     停止并卸载定时监控
#   openclaw-watchdog status   查看监控运行状态
#   openclaw-watchdog check    手动执行一次健康检查

set -euo pipefail

# ══════════════════════════════════════════════
# 常量
# ══════════════════════════════════════════════

readonly VERSION="1.0.0"
readonly LAUNCH_LABEL="com.cc-skills.openclaw-watchdog"
readonly PLIST_PATH="$HOME/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
readonly DATA_DIR="$HOME/.openclaw-watchdog"
readonly SCRIPT_PATH="$DATA_DIR/watchdog.sh"
readonly LOG_DIR="$DATA_DIR/logs"
readonly LOG_FILE="$LOG_DIR/watchdog.log"
readonly STATE_DIR="$DATA_DIR/state"
readonly RESULT_FILE="$STATE_DIR/last-result.json"
readonly COOLDOWN_FILE="$STATE_DIR/last-restart"
readonly INTERVAL_SECONDS=300       # 5 分钟
readonly COOLDOWN_SECONDS=600       # 10 分钟冷却
readonly MAX_LOG_LINES=2000
readonly HEALTH_URL="http://127.0.0.1:18789/healthz"
readonly HEALTH_TIMEOUT=15

# ══════════════════════════════════════════════
# 颜色 & 输出
# ══════════════════════════════════════════════

if [[ -t 1 ]]; then
  readonly C_RESET=$'\033[0m'
  readonly C_BOLD=$'\033[1m'
  readonly C_DIM=$'\033[2m'
  readonly C_GREEN=$'\033[32m'
  readonly C_RED=$'\033[31m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_CYAN=$'\033[36m'
  readonly C_GRAY=$'\033[90m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_GREEN='' C_RED='' C_YELLOW='' C_CYAN='' C_GRAY=''
fi

info()  { echo "${C_CYAN}▸${C_RESET} $*"; }
ok()    { echo "${C_GREEN}✓${C_RESET} $*"; }
warn()  { echo "${C_YELLOW}⚠${C_RESET} $*"; }
err()   { echo "${C_RED}✗${C_RESET} $*" >&2; }

# ══════════════════════════════════════════════
# 工具函数
# ══════════════════════════════════════════════

# 确保 openclaw 可用
resolve_openclaw() {
  if command -v openclaw &>/dev/null; then
    command -v openclaw
  elif [[ -x "$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node/" 2>/dev/null | tail -1)/bin/openclaw" ]]; then
    echo "$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node/" | tail -1)/bin/openclaw"
  else
    echo "openclaw"
  fi
}

# 构建 launchd 用的 PATH（包含 nvm）
build_launchd_path() {
  local nvm_dir=""
  if [[ -d "$HOME/.nvm/versions/node" ]]; then
    local latest
    latest=$(ls "$HOME/.nvm/versions/node/" 2>/dev/null | sort -V | tail -1)
    if [[ -n "$latest" ]]; then
      nvm_dir="$HOME/.nvm/versions/node/$latest/bin"
    fi
  fi
  local parts=("$nvm_dir" "/opt/homebrew/bin" "/usr/local/bin" "/usr/bin" "/bin" "/usr/sbin" "/sbin")
  local IFS=":"
  echo "${parts[*]}"
}

# 人类可读的时间差
time_ago() {
  local ts="$1"
  local now
  now=$(date +%s)
  local diff=$(( now - ts ))
  if (( diff < 60 )); then
    echo "${diff} 秒前"
  elif (( diff < 3600 )); then
    echo "$(( diff / 60 )) 分钟前"
  elif (( diff < 86400 )); then
    echo "$(( diff / 3600 )) 小时前"
  else
    echo "$(( diff / 86400 )) 天前"
  fi
}

# ══════════════════════════════════════════════
# 生成监控脚本 (watchdog.sh)
# ══════════════════════════════════════════════

generate_watchdog_script() {
  local openclaw_path
  openclaw_path=$(resolve_openclaw)
  local launchd_path
  launchd_path=$(build_launchd_path)

  cat << 'OUTER_EOF'
#!/usr/bin/env bash
# 由 openclaw-watchdog 自动生成，请勿手动编辑
set -uo pipefail

OUTER_EOF

  cat << EOF
readonly OPENCLAW="${openclaw_path}"
readonly LAUNCH_PATH="${launchd_path}"
readonly LOG_FILE="${LOG_FILE}"
readonly RESULT_FILE="${RESULT_FILE}"
readonly COOLDOWN_FILE="${COOLDOWN_FILE}"
readonly STATE_DIR="${STATE_DIR}"
readonly MAX_LOG_LINES=${MAX_LOG_LINES}
readonly HEALTH_URL="${HEALTH_URL}"
readonly HEALTH_TIMEOUT=${HEALTH_TIMEOUT}
readonly COOLDOWN_SECONDS=${COOLDOWN_SECONDS}
EOF

  cat << 'OUTER_EOF'

export PATH="$LAUNCH_PATH:$PATH"

mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$RESULT_FILE")"

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "[$(ts)] $*" >> "$LOG_FILE"; }

# ── 日志轮转 ──
rotate_log() {
  if [[ -f "$LOG_FILE" ]]; then
    local lines
    lines=$(wc -l < "$LOG_FILE" | tr -d ' ')
    if (( lines > MAX_LOG_LINES )); then
      tail -n 500 "$LOG_FILE" > "$LOG_FILE.tmp"
      mv "$LOG_FILE.tmp" "$LOG_FILE"
      log "log rotated (kept 500 lines)"
    fi
  fi
}

# ── 冷却检查 ──
in_cooldown() {
  if [[ -f "$COOLDOWN_FILE" ]]; then
    local last now
    last=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
    now=$(date +%s)
    (( now - last < COOLDOWN_SECONDS )) && return 0
  fi
  return 1
}

set_cooldown() {
  date +%s > "$COOLDOWN_FILE"
}

# ── 健康检查 1: HTTP /healthz ──
check_http() {
  local resp
  resp=$(curl -sf --max-time "$HEALTH_TIMEOUT" "$HEALTH_URL" 2>/dev/null) || return 1
  echo "$resp" | grep -q '"ok":true' || return 1
  return 0
}

# ── 健康检查 2: CLI runtime status ──
check_cli() {
  local json status
  json=$("$OPENCLAW" gateway status --json --no-probe --timeout 10000 2>/dev/null) || return 1
  status=$(echo "$json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('service',{}).get('runtime',{}).get('status','unknown'))
except: print('unknown')
" 2>/dev/null)
  [[ "$status" == "running" ]] || return 1
  return 0
}

# ── 健康检查 3: 微信 channel ──
check_weixin() {
  local out
  out=$("$OPENCLAW" gateway health 2>/dev/null) || return 1
  echo "$out" | grep -qi "openclaw-weixin.*configured" || return 1
  return 0
}

# ── 计数器（用独立文件，比读 JSON 更可靠）──
COUNTER_CHECKS="${STATE_DIR}/total-checks"
COUNTER_RESTARTS="${STATE_DIR}/total-restarts"

inc_counter() {
  local file="$1"
  local val=0
  [[ -f "$file" ]] && val=$(cat "$file" 2>/dev/null || echo 0)
  echo $(( val + 1 )) > "$file"
}

get_counter() {
  local file="$1"
  [[ -f "$file" ]] && cat "$file" 2>/dev/null || echo 0
}

# ── 写结果到 JSON ──
write_result() {
  local http_ok="$1" cli_ok="$2" weixin_ok="$3" restarted="$4"

  inc_counter "$COUNTER_CHECKS"
  if $restarted; then
    inc_counter "$COUNTER_RESTARTS"
  fi

  cat > "$RESULT_FILE" << JSONEOF
{
  "timestamp": $(date +%s),
  "checks": {
    "http": ${http_ok},
    "cli": ${cli_ok},
    "weixin": ${weixin_ok}
  },
  "restarted": ${restarted},
  "total_checks": $(get_counter "$COUNTER_CHECKS"),
  "total_restarts": $(get_counter "$COUNTER_RESTARTS")
}
JSONEOF
}

# ══════════════════════════════════════════════
# 主逻辑
# ══════════════════════════════════════════════

rotate_log

http_ok=true; check_http   || http_ok=false
cli_ok=true;  check_cli    || cli_ok=false
wx_ok=true;   check_weixin || wx_ok=false

restarted=false

if $http_ok && $cli_ok && $wx_ok; then
  log "✓ all checks passed"
  write_result true true true false
  exit 0
fi

# 有失败项
failures=""
$http_ok || failures="${failures}http "
$cli_ok  || failures="${failures}cli "
$wx_ok   || failures="${failures}weixin "
log "⚠ check(s) failed: ${failures}"

if in_cooldown; then
  log "🕐 cooldown active, skipping restart"
  write_result "$http_ok" "$cli_ok" "$wx_ok" false
  exit 0
fi

log "🔄 attempting gateway restart..."
if "$OPENCLAW" gateway restart --wait 30s >> "$LOG_FILE" 2>&1; then
  log "✅ restart succeeded"
  restarted=true
  set_cooldown
else
  log "❌ restart failed"
fi

write_result "$http_ok" "$cli_ok" "$wx_ok" "$restarted"
OUTER_EOF
}

# ══════════════════════════════════════════════
# 生成 launchd plist
# ══════════════════════════════════════════════

generate_plist() {
  local launchd_path
  launchd_path=$(build_launchd_path)
  cat << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LAUNCH_LABEL}</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${SCRIPT_PATH}</string>
  </array>

  <key>StartInterval</key>
  <integer>${INTERVAL_SECONDS}</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>${launchd_path}</string>
    <key>HOME</key>
    <string>${HOME}</string>
  </dict>

  <key>StandardOutPath</key>
  <string>${LOG_DIR}/launchd-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/launchd-stderr.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF
}

# ══════════════════════════════════════════════
# 子命令: start
# ══════════════════════════════════════════════

cmd_start() {
  # 检查 openclaw 是否存在
  if ! command -v openclaw &>/dev/null; then
    err "未找到 openclaw 命令，请先安装 OpenClaw"
    exit 1
  fi

  # 如果已经在运行，先停止
  if launchctl list | grep -q "$LAUNCH_LABEL" 2>/dev/null; then
    info "检测到已有 watchdog 运行中，先停止..."
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
  fi

  # 创建目录
  mkdir -p "$DATA_DIR" "$LOG_DIR" "$STATE_DIR"

  # 生成监控脚本
  info "生成监控脚本 → $SCRIPT_PATH"
  generate_watchdog_script > "$SCRIPT_PATH"
  chmod +x "$SCRIPT_PATH"

  # 生成 launchd plist
  info "生成 LaunchAgent → $PLIST_PATH"
  generate_plist > "$PLIST_PATH"

  # 加载
  info "加载 LaunchAgent..."
  launchctl load "$PLIST_PATH"

  echo ""
  ok "Watchdog 已启动"
  echo ""
  echo "  调度间隔:  每 ${INTERVAL_SECONDS} 秒 ($(( INTERVAL_SECONDS / 60 )) 分钟)"
  echo "  重启冷却:  ${COOLDOWN_SECONDS} 秒 ($(( COOLDOWN_SECONDS / 60 )) 分钟)"
  echo "  日志文件:  $LOG_FILE"
  echo "  状态查询:  openclaw-watchdog status"
  echo ""
}

# ══════════════════════════════════════════════
# 子命令: stop
# ══════════════════════════════════════════════

cmd_stop() {
  local was_running=false

  if launchctl list | grep -q "$LAUNCH_LABEL" 2>/dev/null; then
    was_running=true
    info "卸载 LaunchAgent..."
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
  fi

  if [[ -f "$PLIST_PATH" ]]; then
    info "删除 plist → $PLIST_PATH"
    rm -f "$PLIST_PATH"
  fi

  if $was_running; then
    ok "Watchdog 已停止"
  else
    warn "Watchdog 未在运行"
  fi

  # 保留日志和状态数据，不自动删除
  info "日志和状态数据保留在 $DATA_DIR（可手动删除）"
}

# ══════════════════════════════════════════════
# 子命令: status
# ══════════════════════════════════════════════

cmd_status() {
  echo ""
  echo "${C_BOLD}╭─ OpenClaw Watchdog ─────────────────────────────╮${C_RESET}"

  # LaunchAgent 状态
  local agent_status="未安装"
  local agent_icon="⚪"
  local agent_detail=""

  if [[ -f "$PLIST_PATH" ]]; then
    if launchctl list | grep -q "$LAUNCH_LABEL" 2>/dev/null; then
      agent_icon="🟢"
      agent_status="运行中"
      local pid
      pid=$(launchctl list "$LAUNCH_LABEL" 2>/dev/null | python3 -c "
import sys
for line in sys.stdin:
    if '\"PID\"' in line:
        parts = line.split('=')
        if len(parts) >= 2:
            v = parts[1].strip().rstrip(';').strip().strip('\"')
            print(v if v else '')
" 2>/dev/null || echo "")
      if [[ -n "$pid" ]]; then
        agent_detail=" (pid $pid)"
      fi
    else
      agent_icon="🔴"
      agent_status="已停止"
    fi
  fi

  printf "│  %-12s %s %-30s│\n" "状态:" "${agent_icon} ${agent_status}" "${agent_detail}"
  printf "│  %-12s %-40s│\n" "LaunchAgent:" "$(
    if [[ -f "$PLIST_PATH" ]]; then echo "✅ installed"; else echo "❌ not installed"; fi
  )"

  # 上次检查结果
  if [[ -f "$RESULT_FILE" ]]; then
    local ts http_ok cli_ok wx_ok restarted total_checks total_restarts
    ts=$(python3 -c "import json; print(json.load(open('$RESULT_FILE')).get('timestamp',0))" 2>/dev/null || echo 0)
    local checks
    checks=$(python3 -c "
import json
d = json.load(open('$RESULT_FILE'))
c = d.get('checks', {})
print(
    ('✓' if c.get('http') else '✗') + ' HTTP  ' +
    ('✓' if c.get('cli') else '✗') + ' CLI  ' +
    ('✓' if c.get('weixin') else '✗') + ' WeChat'
)
" 2>/dev/null || echo "读取失败")

    total_checks=$(python3 -c "import json; print(json.load(open('$RESULT_FILE')).get('total_checks',0))" 2>/dev/null || echo 0)
    total_restarts=$(python3 -c "import json; print(json.load(open('$RESULT_FILE')).get('total_restarts',0))" 2>/dev/null || echo 0)

    printf "│  %-12s %-40s│\n" "上次检查:" "$(time_ago "$ts")"
    printf "│  %-12s %-40s│\n" "检查结果:" "$checks"
    printf "│  %-12s %-40s│\n" "检查次数:" "$total_checks"
    printf "│  %-12s %-40s│\n" "重启次数:" "$total_restarts"

    # 上次重启时间
    if [[ -f "$COOLDOWN_FILE" ]]; then
      local restart_ts
      restart_ts=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
      printf "│  %-12s %-40s│\n" "上次重启:" "$(time_ago "$restart_ts")"
    else
      printf "│  %-12s %-40s│\n" "上次重启:" "无 (从未触发)"
    fi
  else
    printf "│  %-12s %-40s│\n" "上次检查:" "暂无数据"
  fi

  echo "${C_BOLD}╰─────────────────────────────────────────────────╯${C_RESET}"

  # 最近日志
  if [[ -f "$LOG_FILE" ]]; then
    local line_count
    line_count=$(wc -l < "$LOG_FILE" | tr -d ' ')
    echo ""
    echo "${C_DIM}最近 5 条日志 (共 ${line_count} 行):${C_RESET}"
    tail -n 5 "$LOG_FILE" | while IFS= read -r line; do
      echo "  ${C_GRAY}${line}${C_RESET}"
    done
  fi

  echo ""
}

# ══════════════════════════════════════════════
# 子命令: check
# ══════════════════════════════════════════════

cmd_check() {
  info "手动执行健康检查..."
  echo ""

  local all_ok=true

  # Check 1
  printf "  %-20s" "HTTP /healthz:"
  if curl -sf --max-time "$HEALTH_TIMEOUT" "$HEALTH_URL" 2>/dev/null | grep -q '"ok":true'; then
    ok "正常"
  else
    err "失败"
    all_ok=false
  fi

  # Check 2
  printf "  %-20s" "CLI runtime:"
  local cli_json cli_status
  cli_json=$(openclaw gateway status --json --no-probe --timeout 10000 2>/dev/null) || cli_json=""
  cli_status=$(echo "$cli_json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('service',{}).get('runtime',{}).get('status','unknown'))
except: print('unknown')
" 2>/dev/null || echo "unknown")
  if [[ "$cli_status" == "running" ]]; then
    ok "running (pid $(echo "$cli_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('service',{}).get('runtime',{}).get('pid','?'))" 2>/dev/null || echo '?'))"
  else
    err "status=$cli_status"
    all_ok=false
  fi

  # Check 3
  printf "  %-20s" "WeChat channel:"
  local health_out
  health_out=$(openclaw gateway health 2>/dev/null) || health_out=""
  if echo "$health_out" | grep -qi "openclaw-weixin.*configured"; then
    ok "configured"
  else
    err "未配置或异常"
    all_ok=false
  fi

  echo ""
  if $all_ok; then
    ok "全部检查通过 ✓"
  else
    warn "存在异常项，watchdog 会在自动检查时触发重启"
  fi
}

# ══════════════════════════════════════════════
# 子命令: help
# ══════════════════════════════════════════════

cmd_help() {
  cat << EOF

${C_BOLD}openclaw-watchdog${C_RESET} v${VERSION} — OpenClaw Gateway 健康监控

${C_BOLD}用法:${C_RESET}
  openclaw-watchdog <command>

${C_BOLD}命令:${C_RESET}
  ${C_GREEN}start${C_RESET}     安装 LaunchAgent 并启动定时监控 (每 5 分钟)
  ${C_GREEN}stop${C_RESET}      停止并卸载 LaunchAgent
  ${C_GREEN}status${C_RESET}    查看 watchdog 运行状态和最近日志
  ${C_GREEN}check${C_RESET}     手动执行一次健康检查 (调试用)
  ${C_GREEN}help${C_RESET}      显示本帮助信息

${C_BOLD}示例:${C_RESET}
  openclaw-watchdog start     ${C_GRAY}# 启动监控${C_RESET}
  openclaw-watchdog status    ${C_GRAY}# 查看状态${C_RESET}
  openclaw-watchdog check     ${C_GRAY}# 手动检查一次${C_RESET}
  openclaw-watchdog stop      ${C_GRAY}# 停止监控${C_RESET}

${C_BOLD}文件位置:${C_RESET}
  监控脚本:  ~/.openclaw-watchdog/watchdog.sh
  运行日志:  ~/.openclaw-watchdog/logs/watchdog.log
  状态数据:  ~/.openclaw-watchdog/state/last-result.json
  LaunchAgent: ~/Library/LaunchAgents/${LAUNCH_LABEL}.plist

EOF
}

# ══════════════════════════════════════════════
# 入口
# ══════════════════════════════════════════════

case "${1:-help}" in
  start)  cmd_start  ;;
  stop)   cmd_stop   ;;
  status) cmd_status ;;
  check)  cmd_check  ;;
  help|-h|--help) cmd_help ;;
  *)
    err "未知命令: $1"
    cmd_help
    exit 1
    ;;
esac
