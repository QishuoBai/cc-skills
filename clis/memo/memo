#!/usr/bin/env bash
#
# memo — 提醒事项管理 CLI
#
# 记录、查询、修改和删除提醒事项，支持一次性提醒和周期性循环提醒。
# 数据存储在 ~/.memo/ 目录，JSON 格式，零额外依赖（仅需 python3）。
#
# 用法:
#   memo                              显示今天的提醒
#   memo list [YYYY-MM-DD]            列出某天的提醒
#   memo add <text> [-d YYYY-MM-DD]   添加一次性提醒
#   memo add <text> --daily           添加每天循环提醒
#   memo add <text> --weekly <1-7>    添加每周循环提醒
#   memo add <text> --monthly <1-31>  添加每月循环提醒
#   memo add <text> --yearly <MM-DD>  添加每年循环提醒
#   memo done <id>                    标记提醒完成
#   memo undone <id>                  取消完成标记
#   memo edit <id> <new text>         修改提醒内容
#   memo rm <id>                      删除提醒
#   memo search <keyword>             搜索提醒

set -euo pipefail

# ══════════════════════════════════════════════
# 常量
# ══════════════════════════════════════════════

readonly VERSION="1.0.0"
readonly DATA_DIR="$HOME/.memo"
readonly CONFIG_FILE="$DATA_DIR/config.json"
readonly REMINDERS_DIR="$DATA_DIR/reminders"
readonly RECURRING_FILE="$DATA_DIR/recurring.json"
readonly HELPER_FILE="$DATA_DIR/.helper.py"

# ══════════════════════════════════════════════
# 颜色 & 输出
# ══════════════════════════════════════════════

if [[ -t 1 ]]; then
  readonly C_RESET=$'\033[0m'
  readonly C_BOLD=$'\033[1m'
  readonly C_DIM=$'\033[2m'
  readonly C_GREEN=$'\033[32m'
  readonly C_RED=$'\033[31m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_CYAN=$'\033[36m'
  readonly C_GRAY=$'\033[90m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_GREEN='' C_RED='' C_YELLOW='' C_CYAN='' C_GRAY=''
fi

info()  { echo "${C_CYAN}▸${C_RESET} $*"; }
ok()    { echo "${C_GREEN}✓${C_RESET} $*"; }
warn()  { echo "${C_YELLOW}⚠${C_RESET} $*"; }
err()   { echo "${C_RED}✗${C_RESET} $*" >&2; }

# ══════════════════════════════════════════════
# 初始化
# ══════════════════════════════════════════════

ensure_data_dir() {
  mkdir -p "$DATA_DIR" "$REMINDERS_DIR"
  [[ -f "$CONFIG_FILE" ]] || echo '{"next_id": 1}' > "$CONFIG_FILE"
  [[ -f "$RECURRING_FILE" ]] || echo '[]' > "$RECURRING_FILE"

  # 始终覆写辅助脚本（确保版本一致）
  cat <<'PYEOF' > "$HELPER_FILE"
#!/usr/bin/env python3
"""memo 辅助脚本 — 处理所有 JSON 操作和显示逻辑"""
import json, sys, os
from datetime import datetime

data_dir = os.environ.get("MEMO_DATA_DIR", os.path.expanduser("~/.memo"))
config_path = os.path.join(data_dir, "config.json")
recurring_path = os.path.join(data_dir, "recurring.json")
reminders_dir = os.path.join(data_dir, "reminders")

ESC = chr(27)
DIM = f"{ESC}[2m"
CYAN = f"{ESC}[36m"
GRAY = f"{ESC}[90m"
RESET = f"{ESC}[0m"

WEEKDAY_CN = {1:"周一", 2:"周二", 3:"周三", 4:"周四", 5:"周五", 6:"周六", 7:"周日"}

def load_json(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def freq_label(freq, days, date_val):
    if freq == "daily":
        return "每天"
    if freq == "weekly":
        names = [WEEKDAY_CN.get(d, "?") for d in days]
        return "每" + "、".join(names)
    if freq == "monthly":
        return "每月" + "、".join(f"{d}号" for d in days)
    if freq == "yearly":
        return f"每年{date_val}"
    return freq

cmd = sys.argv[1] if len(sys.argv) > 1 else "init"

# ── init ──────────────────────────────────────
if cmd == "init":
    if not os.path.exists(config_path):
        save_json(config_path, {"next_id": 1})
    if not os.path.exists(recurring_path):
        save_json(recurring_path, [])
    os.makedirs(reminders_dir, exist_ok=True)

# ── next_id ───────────────────────────────────
elif cmd == "next_id":
    config = load_json(config_path) or {"next_id": 1}
    nid = config["next_id"]
    config["next_id"] = nid + 1
    save_json(config_path, config)
    print(nid)

# ── add_onetime ───────────────────────────────
elif cmd == "add_onetime":
    date_str, rid, text, created = sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5]
    rpath = os.path.join(reminders_dir, date_str + ".json")
    reminders = load_json(rpath) or []
    reminders.append({"id": rid, "text": text, "done": False, "created_at": created})
    save_json(rpath, reminders)

# ── add_recurring ─────────────────────────────
elif cmd == "add_recurring":
    rid, text, freq, created = int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
    item = {"id": rid, "text": text, "freq": freq, "done_dates": [], "created_at": created}
    if freq == "weekly":
        item["days"] = [int(x) for x in sys.argv[6].split(",")]
    elif freq == "monthly":
        item["days"] = [int(x) for x in sys.argv[6].split(",")]
    elif freq == "yearly":
        item["date"] = sys.argv[6]
    recurring = load_json(recurring_path) or []
    recurring.append(item)
    save_json(recurring_path, recurring)

# ── list ──────────────────────────────────────
elif cmd == "list":
    date_str = sys.argv[2]
    dt = datetime.strptime(date_str, "%Y-%m-%d")
    weekday = dt.isoweekday()
    dom = dt.day
    md = dt.strftime("%m-%d")
    wd_cn = WEEKDAY_CN.get(weekday, "?")

    # 一次性提醒
    rpath = os.path.join(reminders_dir, date_str + ".json")
    onetime = load_json(rpath) or []

    # 匹配的循环提醒
    recurring = load_json(recurring_path) or []
    matched_recurring = []
    for r in recurring:
        match = False
        if r["freq"] == "daily":
            match = True
        elif r["freq"] == "weekly" and weekday in r.get("days", []):
            match = True
        elif r["freq"] == "monthly" and dom in r.get("days", []):
            match = True
        elif r["freq"] == "yearly" and md == r.get("date", ""):
            match = True
        if match:
            r_copy = dict(r)
            r_copy["matched_done"] = date_str in r.get("done_dates", [])
            matched_recurring.append(r_copy)

    print()
    print(f"{ESC}[1m📅 {date_str} {wd_cn}{RESET}")
    print()

    total = 0
    done_count = 0

    if not onetime and not matched_recurring:
        print(f"  {DIM}暂无提醒{RESET}")
        print()
        print(f"{CYAN}▸{RESET} 使用 {ESC}[1mmemo add <text>{RESET} 添加提醒")
        print()
        sys.exit(0)

    # 显示一次性提醒
    for r in onetime:
        d = r.get("done", False)
        icon = "✓" if d else "○"
        color = DIM if d else ""
        reset_c = RESET if d else ""
        print(f"  {icon} [{r['id']}] {color}{r['text']}{reset_c}")
        total += 1
        if d:
            done_count += 1

    # 显示循环提醒
    for r in matched_recurring:
        d = r.get("matched_done", False)
        icon = "✓" if d else "○"
        color = DIM if d else ""
        reset_c = RESET if d else ""
        label = freq_label(r["freq"], r.get("days", []), r.get("date", ""))
        print(f"  {icon} [{r['id']}] {color}{r['text']}{reset_c}  {CYAN}🔁 {label}{RESET}")
        total += 1
        if d:
            done_count += 1

    pending = total - done_count
    print()
    print(f"{DIM}总计: {total} 项 | 已完成: {done_count} | 待办: {pending}{RESET}")
    print()

# ── done ──────────────────────────────────────
elif cmd == "done":
    rid = int(sys.argv[2])
    date_str = sys.argv[3] if len(sys.argv) > 3 else None
    found = False

    if date_str:
        rpath = os.path.join(reminders_dir, date_str + ".json")
        reminders = load_json(rpath)
        if reminders:
            for r in reminders:
                if r["id"] == rid:
                    r["done"] = True
                    found = True
                    break
            if found:
                save_json(rpath, reminders)

    if not found:
        recurring = load_json(recurring_path) or []
        for r in recurring:
            if r["id"] == rid:
                if date_str and date_str not in r["done_dates"]:
                    r["done_dates"].append(date_str)
                found = True
                save_json(recurring_path, recurring)
                break

    print("ok" if found else "not_found")

# ── undone ────────────────────────────────────
elif cmd == "undone":
    rid = int(sys.argv[2])
    date_str = sys.argv[3] if len(sys.argv) > 3 else None
    found = False

    if date_str:
        rpath = os.path.join(reminders_dir, date_str + ".json")
        reminders = load_json(rpath)
        if reminders:
            for r in reminders:
                if r["id"] == rid:
                    r["done"] = False
                    found = True
                    break
            if found:
                save_json(rpath, reminders)

    if not found:
        recurring = load_json(recurring_path) or []
        for r in recurring:
            if r["id"] == rid:
                if date_str and date_str in r["done_dates"]:
                    r["done_dates"].remove(date_str)
                found = True
                save_json(recurring_path, recurring)
                break

    print("ok" if found else "not_found")

# ── edit ──────────────────────────────────────
elif cmd == "edit":
    rid = int(sys.argv[2])
    new_text = sys.argv[3]
    found = False

    for fname in os.listdir(reminders_dir):
        if not fname.endswith(".json"):
            continue
        rpath = os.path.join(reminders_dir, fname)
        reminders = load_json(rpath) or []
        for r in reminders:
            if r["id"] == rid:
                r["text"] = new_text
                found = True
                break
        if found:
            save_json(rpath, reminders)
            break

    if not found:
        recurring = load_json(recurring_path) or []
        for r in recurring:
            if r["id"] == rid:
                r["text"] = new_text
                found = True
                break
        if found:
            save_json(recurring_path, recurring)

    print("ok" if found else "not_found")

# ── rm ────────────────────────────────────────
elif cmd == "rm":
    rid = int(sys.argv[2])
    found = False

    for fname in os.listdir(reminders_dir):
        if not fname.endswith(".json"):
            continue
        rpath = os.path.join(reminders_dir, fname)
        reminders = load_json(rpath) or []
        new_reminders = [r for r in reminders if r["id"] != rid]
        if len(new_reminders) < len(reminders):
            save_json(rpath, new_reminders)
            found = True
            break

    if not found:
        recurring = load_json(recurring_path) or []
        new_recurring = [r for r in recurring if r["id"] != rid]
        if len(new_recurring) < len(recurring):
            save_json(recurring_path, new_recurring)
            found = True

    print("ok" if found else "not_found")

# ── search ────────────────────────────────────
elif cmd == "search":
    keyword = sys.argv[2]
    results = []

    for fname in sorted(os.listdir(reminders_dir)):
        if not fname.endswith(".json"):
            continue
        reminders = load_json(os.path.join(reminders_dir, fname)) or []
        for r in reminders:
            if keyword in r.get("text", ""):
                r["date"] = fname.replace(".json", "")
                r["type"] = "onetime"
                results.append(r)

    recurring = load_json(recurring_path) or []
    for r in recurring:
        if keyword in r.get("text", ""):
            r["type"] = "recurring"
            results.append(r)

    if not results:
        print(f"NOT_FOUND:{keyword}")
        sys.exit(0)

    print()
    print(f"{ESC}[1m🔍 搜索: \"{keyword}\"{RESET} {DIM}({len(results)} 个结果){RESET}")
    print()

    for r in results:
        d = r.get("done", False) or r.get("matched_done", False)
        icon = "✓" if d else "○"
        color = DIM if d else ""
        reset_c = RESET if d else ""
        if r["type"] == "onetime":
            print(f"  {icon} [{r['id']}] {color}{r['text']}{reset_c}  {GRAY}{r['date']}{RESET}")
        else:
            label = freq_label(r["freq"], r.get("days", []), r.get("date", ""))
            print(f"  {icon} [{r['id']}] {color}{r['text']}{reset_c}  {CYAN}🔁 {label}{RESET}")

    print()
PYEOF
}

# 调用 Python 辅助脚本
json() {
  MEMO_DATA_DIR="$DATA_DIR" python3 "$HELPER_FILE" "$@"
}

# ══════════════════════════════════════════════
# 工具函数
# ══════════════════════════════════════════════

today() { date "+%Y-%m-%d"; }

validate_date() {
  local d="$1"
  if [[ ! "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    return 1
  fi
  date -j -f "%Y-%m-%d" "$d" "+%Y-%m-%d" &>/dev/null || return 1
  return 0
}

weekday_name() {
  case "$1" in
    1) echo "周一" ;; 2) echo "周二" ;; 3) echo "周三" ;;
    4) echo "周四" ;; 5) echo "周五" ;; 6) echo "周六" ;; 7) echo "周日" ;;
    *) echo "?" ;;
  esac
}

freq_label() {
  local freq="$1" days="$2" date_val="$3"
  case "$freq" in
    daily)   echo "每天" ;;
    weekly)
      local names=""
      IFS=',' read -ra day_arr <<< "$days"
      for d in "${day_arr[@]}"; do
        local n
        n=$(weekday_name "$d")
        if [[ -n "$names" ]]; then
          names="${names}、${n}"
        else
          names="$n"
        fi
      done
      echo "每${names}"
      ;;
    monthly)
      local names=""
      IFS=',' read -ra day_arr <<< "$days"
      for d in "${day_arr[@]}"; do
        if [[ -n "$names" ]]; then
          names="${names}、${d}号"
        else
          names="${d}号"
        fi
      done
      echo "每月${names}"
      ;;
    yearly)  echo "每年${date_val}" ;;
    *)       echo "$freq" ;;
  esac
}

next_id() {
  json next_id
}

# ══════════════════════════════════════════════
# 子命令
# ══════════════════════════════════════════════

cmd_list() {
  local d="${1:-$(today)}"

  if ! validate_date "$d"; then
    err "无效的日期格式: ${d}（请使用 YYYY-MM-DD）"
    exit 1
  fi

  json list "$d"
}

cmd_add() {
  local text=""
  local date_val=""
  local freq=""
  local freq_arg=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d|--date)
        date_val="${2:-}"
        if [[ -z "$date_val" ]]; then
          err "-d 需要一个日期参数"
          exit 1
        fi
        shift 2
        ;;
      --daily)
        freq="daily"
        shift
        ;;
      --weekly)
        freq="weekly"
        freq_arg="${2:-}"
        if [[ -z "$freq_arg" ]]; then
          err "--weekly 需要指定星期几（1-7）"
          exit 1
        fi
        shift 2
        ;;
      --monthly)
        freq="monthly"
        freq_arg="${2:-}"
        if [[ -z "$freq_arg" ]]; then
          err "--monthly 需要指定几号（1-31）"
          exit 1
        fi
        shift 2
        ;;
      --yearly)
        freq="yearly"
        freq_arg="${2:-}"
        if [[ -z "$freq_arg" ]]; then
          err "--yearly 需要指定日期（MM-DD）"
          exit 1
        fi
        shift 2
        ;;
      *)
        if [[ -z "$text" ]]; then
          text="$1"
        else
          text="${text} $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$text" ]]; then
    err "请指定提醒内容"
    echo ""
    echo "用法: memo add <text> [-d YYYY-MM-DD | --daily | --weekly <1-7> | --monthly <1-31> | --yearly <MM-DD>]"
    exit 1
  fi

  # 日期验证
  if [[ -n "$date_val" ]]; then
    if ! validate_date "$date_val"; then
      err "无效的日期格式: ${date_val}（请使用 YYYY-MM-DD）"
      exit 1
    fi
  fi

  # 循环提醒参数验证
  if [[ "$freq" == "weekly" ]]; then
    if ! [[ "$freq_arg" =~ ^[1-7](,[1-7])*$ ]]; then
      err "星期格式无效: ${freq_arg}（请使用 1-7，如 1,3,5 表示周一、三、五）"
      exit 1
    fi
  elif [[ "$freq" == "monthly" ]]; then
    if ! [[ "$freq_arg" =~ ^([1-9]|[12][0-9]|3[01])(,([1-9]|[12][0-9]|3[01]))*$ ]]; then
      err "日期格式无效: ${freq_arg}（请使用 1-31，如 1,15）"
      exit 1
    fi
  elif [[ "$freq" == "yearly" ]]; then
    if ! [[ "$freq_arg" =~ ^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$ ]]; then
      err "日期格式无效: ${freq_arg}（请使用 MM-DD 格式，如 12-25）"
      exit 1
    fi
  fi

  local id
  id=$(next_id)
  local created
  created=$(date "+%Y-%m-%dT%H:%M:%S")

  if [[ -z "$freq" ]]; then
    # 一次性提醒
    local target_date="${date_val:-$(today)}"
    json add_onetime "$target_date" "$id" "$text" "$created"
    ok "已添加提醒 [${id}]: ${text}（${target_date}）"
  else
    # 循环提醒
    case "$freq" in
      daily)
        json add_recurring "$id" "$text" "daily" "$created"
        ok "已添加每天循环提醒 [${id}]: ${text}"
        ;;
      weekly)
        json add_recurring "$id" "$text" "weekly" "$created" "$freq_arg"
        local label
        label=$(freq_label "weekly" "$freq_arg" "")
        ok "已添加${label}循环提醒 [${id}]: ${text}"
        ;;
      monthly)
        json add_recurring "$id" "$text" "monthly" "$created" "$freq_arg"
        local label
        label=$(freq_label "monthly" "$freq_arg" "")
        ok "已添加${label}循环提醒 [${id}]: ${text}"
        ;;
      yearly)
        json add_recurring "$id" "$text" "yearly" "$created" "$freq_arg"
        local label
        label=$(freq_label "yearly" "" "$freq_arg")
        ok "已添加${label}循环提醒 [${id}]: ${text}"
        ;;
    esac
  fi
}

cmd_done() {
  local id="${1:-}"
  local date_val="${2:-$(today)}"

  if [[ -z "$id" ]]; then
    err "请指定提醒 ID"
    echo "用法: memo done <id> [YYYY-MM-DD]"
    exit 1
  fi

  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    err "无效的提醒 ID: $id"
    exit 1
  fi

  local result
  result=$(json done "$id" "$date_val")

  if [[ "$result" == "ok" ]]; then
    ok "已标记完成 [${id}]"
  else
    err "未找到提醒 [${id}]"
    exit 1
  fi
}

cmd_undone() {
  local id="${1:-}"
  local date_val="${2:-$(today)}"

  if [[ -z "$id" ]]; then
    err "请指定提醒 ID"
    echo "用法: memo undone <id> [YYYY-MM-DD]"
    exit 1
  fi

  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    err "无效的提醒 ID: $id"
    exit 1
  fi

  local result
  result=$(json undone "$id" "$date_val")

  if [[ "$result" == "ok" ]]; then
    ok "已取消完成标记 [${id}]"
  else
    err "未找到提醒 [${id}]"
    exit 1
  fi
}

cmd_edit() {
  local id="${1:-}"
  shift 2>/dev/null || true
  local new_text="$*"

  if [[ -z "$id" ]]; then
    err "请指定提醒 ID"
    echo "用法: memo edit <id> <new text>"
    exit 1
  fi

  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    err "无效的提醒 ID: $id"
    exit 1
  fi

  if [[ -z "$new_text" ]]; then
    err "请指定新的提醒内容"
    exit 1
  fi

  local result
  result=$(json edit "$id" "$new_text")

  if [[ "$result" == "ok" ]]; then
    ok "已修改提醒 [${id}]: ${new_text}"
  else
    err "未找到提醒 [${id}]"
    exit 1
  fi
}

cmd_rm() {
  local id="${1:-}"

  if [[ -z "$id" ]]; then
    err "请指定提醒 ID"
    echo "用法: memo rm <id>"
    exit 1
  fi

  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    err "无效的提醒 ID: $id"
    exit 1
  fi

  local result
  result=$(json rm "$id")

  if [[ "$result" == "ok" ]]; then
    ok "已删除提醒 [${id}]"
  else
    err "未找到提醒 [${id}]"
    exit 1
  fi
}

cmd_search() {
  local keyword="${1:-}"

  if [[ -z "$keyword" ]]; then
    err "请指定搜索关键词"
    echo "用法: memo search <keyword>"
    exit 1
  fi

  local result
  result=$(json search "$keyword")

  if [[ "$result" == NOT_FOUND:* ]]; then
    warn "未找到包含 \"${keyword}\" 的提醒"
    return
  fi

  echo "$result"
}

cmd_help() {
  cat << EOF

${C_BOLD}memo${C_RESET} v${VERSION} — 提醒事项管理 CLI

${C_BOLD}用法:${C_RESET}
  memo                              显示今天的提醒
  memo list [YYYY-MM-DD]            列出某天的提醒（默认今天）
  memo today                        同上（别名）

${C_BOLD}添加提醒:${C_RESET}
  memo add <text>                   添加今天的提醒
  memo add <text> -d YYYY-MM-DD     添加到指定日期
  memo add <text> --daily           每天循环提醒
  memo add <text> --weekly <days>   每周循环（1=周一..7=周日，逗号分隔）
  memo add <text> --monthly <days>  每月循环（1-31号，逗号分隔）
  memo add <text> --yearly <MM-DD>  每年循环提醒

${C_BOLD}管理提醒:${C_RESET}
  memo done <id> [YYYY-MM-DD]       标记完成（循环提醒需指定日期）
  memo undone <id> [YYYY-MM-DD]     取消完成标记
  memo edit <id> <new text>         修改提醒内容
  memo rm <id>                      删除提醒
  memo search <keyword>             搜索提醒

${C_BOLD}示例:${C_RESET}
  memo add "下午3点开会"                          ${C_GRAY}# 添加到今天${C_RESET}
  memo add "项目截止" -d 2026-06-15               ${C_GRAY}# 添加到指定日期${C_RESET}
  memo add "吃药" --daily                          ${C_GRAY}# 每天提醒${C_RESET}
  memo add "提交周报" --weekly 5                    ${C_GRAY}# 每周五提醒${C_RESET}
  memo add "团队会议" --weekly 1,3,5                ${C_GRAY}# 每周一、三、五${C_RESET}
  memo add "还信用卡" --monthly 1                   ${C_GRAY}# 每月1号${C_RESET}
  memo add "生日祝福" --yearly 12-25                ${C_GRAY}# 每年12月25日${C_RESET}
  memo done 1                                      ${C_GRAY}# 标记 ID 1 完成${C_RESET}
  memo done 2 2026-06-06                           ${C_GRAY}# 标记循环提醒某天完成${C_RESET}
  memo rm 3                                        ${C_GRAY}# 删除 ID 3${C_RESET}
  memo search "开会"                                ${C_GRAY}# 搜索包含"开会"的提醒${C_RESET}

EOF
}

# ══════════════════════════════════════════════
# 入口
# ══════════════════════════════════════════════

main() {
  ensure_data_dir

  case "${1:-}" in
    ""|today)
      cmd_list
      ;;
    list|ls)
      shift
      cmd_list "${1:-}"
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    done)
      shift
      cmd_done "$@"
      ;;
    undone)
      shift
      cmd_undone "$@"
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    rm|remove|del)
      shift
      cmd_rm "$@"
      ;;
    search|find)
      shift
      cmd_search "$@"
      ;;
    help|--help|-h)
      cmd_help
      ;;
    --version|-v)
      echo "memo v${VERSION}"
      ;;
    *)
      err "未知命令: $1"
      echo ""
      echo "运行 ${C_BOLD}memo help${C_RESET} 查看帮助"
      exit 1
      ;;
  esac
}

main "$@"
